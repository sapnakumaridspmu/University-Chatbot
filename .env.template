# ── Database ───────────────────────────────────────────────────────────────────
# IMPORTANT: "localhost" only works when MySQL is running on the SAME machine
# as the app. On Render (or any cloud host), the app container has no local
# MySQL server, so DB_HOST=localhost will ALWAYS fail to connect there.
# On Render, DB_HOST/DB_USER/DB_PASSWORD/DB_NAME/DB_PORT must point to an
# externally reachable MySQL instance (e.g. Railway, Aiven, PlanetScale,
# Clever Cloud, TiDB Cloud, or your own VPS) — set these as Environment
# Variables in the Render dashboard, NOT in a committed .env file.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=university_chatbot
DB_PORT=3306

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Supported: google_genai | openai | anthropic | groq | ollama
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-2.0-flash
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.4
# Optional: OpenAI-compatible base URL (vLLM, Ollama OpenAI shim, LiteLLM proxy, …)
# LLM_BASE_URL=https://models.github.ai/inference

# ── API Keys (provide only what matches your LLM_PROVIDER) ────────────────────
# GOOGLE_API_KEY=
# Or use: GEMINI_API_KEY= (same purpose; either works)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=...
# GROQ_API_KEY=...

# ── Tavily Web Search ──────────────────────────────────────────────────────────
TAVILY_API_KEY=